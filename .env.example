# ParcelResolve Environment Configuration Example
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parcelresolve?schema=public&sslmode=prefer"

JWT_SECRET="parcelresolve_secure_jwt_signing_token_key_change_in_production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Storage Configuration (Local or S3/Cloud Storage)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./public/uploads"

# Linnworks Integration Defaults (Optional)
LINNWORKS_APP_ID="app-parcelresolve-production-v1"
LINNWORKS_APP_SECRET="lw-sec-9a8b7c6d5e4f3a2b1c"

# Sandbox Mode Toggle
NEXT_PUBLIC_SANDBOX_AVAILABLE="true"
